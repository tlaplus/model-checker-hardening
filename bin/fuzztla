#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
project_dir=$(dirname "$script_dir")
jar="$project_dir/target/fuzztla.jar"
apalache_jar="$project_dir/target/apalache.jar"
tla2tools_jar="$project_dir/target/tla2tools.jar"

if ! command -v java >/dev/null 2>&1; then
    printf '%s\n' "fuzztla: Java was not found on PATH." >&2
    exit 127
fi

if [ ! -f "$jar" ]; then
    printf '%s\n' \
        "fuzztla: executable JAR not found: $jar" \
        "Run 'make package' in $project_dir." >&2
    exit 1
fi

for staged in "$apalache_jar" "$tla2tools_jar"; do
    if [ ! -f "$staged" ]; then
        printf '%s\n' \
            "fuzztla: staged tool JAR not found: $staged" \
            "Run 'make package' in $project_dir." >&2
        exit 1
    fi
done

runtime_base=${TMPDIR:-/tmp}
runtime_dir=$(mktemp -d "$runtime_base/fuzztla.XXXXXXXXXX")
runtime_jar="$runtime_dir/fuzztla.jar"
runtime_apalache_jar="$runtime_dir/apalache.jar"
runtime_tla2tools_jar="$runtime_dir/tla2tools.jar"

cleanup() {
    rm -f "$runtime_jar" "$runtime_apalache_jar" "$runtime_tla2tools_jar"
    rmdir "$runtime_dir"
}
trap cleanup EXIT

# Java loads application classes lazily. Run from a private immutable snapshot so
# rebuilding target/fuzztla.jar cannot corrupt the class path of this invocation.
cp "$jar" "$runtime_jar"
cp "$apalache_jar" "$runtime_apalache_jar"
cp "$tla2tools_jar" "$runtime_tla2tools_jar"
# The snapshot lives outside the project, so name the project for the files that
# stay in it, such as the known-defect database that 'fuzztla init' enables.
java "-Dfuzztla.home=$project_dir" -jar "$runtime_jar" "$@"
