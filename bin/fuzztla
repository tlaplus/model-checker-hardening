#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
project_dir=$(dirname "$script_dir")
jar="$project_dir/target/fuzztla.jar"

if ! command -v java >/dev/null 2>&1; then
    printf '%s\n' "fuzztla: Java was not found on PATH." >&2
    exit 127
fi

if [ ! -f "$jar" ]; then
    printf '%s\n' \
        "fuzztla: executable JAR not found: $jar" \
        "Run 'make package' in $project_dir." >&2
    exit 1
fi

runtime_base=${TMPDIR:-/tmp}
runtime_dir=$(mktemp -d "$runtime_base/fuzztla.XXXXXXXXXX")
runtime_jar="$runtime_dir/fuzztla.jar"

cleanup() {
    rm -f "$runtime_jar"
    rmdir "$runtime_dir"
}
trap cleanup EXIT

# Java loads application classes lazily. Run from a private immutable snapshot so
# rebuilding target/fuzztla.jar cannot corrupt the class path of this invocation.
cp "$jar" "$runtime_jar"
java -jar "$runtime_jar" "$@"
