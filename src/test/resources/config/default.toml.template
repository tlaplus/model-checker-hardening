[generator]
# What this run generates: "expr" for one expression wrapped in a single-state module, or "module" for a whole module.
# A corpus entry records its own kind, so a run only generates this one.
kind = "module"
max_type_depth = 3
max_expression_depth = 32
max_nodes = 128
max_collection_size = 8
# Size of a set or sequence literal, and of a collection terminal, when the input is exhausted.
collection_base_size = 3
# Input bytes move a collection's size within base ± spread.
collection_size_spread = 4
# Maximum atoms in one generated collection value, over all nesting levels.
max_value_atoms = 64
max_string_bytes = 32
max_integer_bytes = 16
# Closed integer terminal, and centre of small integer literals.
integer_base = 1
# Input bytes move a small integer literal within base ± spread.
integer_literal_spread = 4
# How integer literals decode: "wide" byte payloads, "small" values around integer_base,
# or "boundary" values such as 2^31 - 1 besides both.
integer_literals = "boundary"
# Maximum state variables declared by a generated module.
max_variables = 3
# Maximum state-free operator definitions a generated module may apply.
max_auxiliary_operators = 2
# Maximum action operator definitions the next-state action may apply.
# Each reads current state and primes a subset of the variables.
max_action_operators = 2
# Maximum disjuncts in a generated next-state action.
max_actions = 3
# Maximum bounded existential parameters of one generated action.
max_action_parameters = 2
# Maximum nesting depth of disjunctions, conjunctions, and IF-THEN-ELSE
# within one generated next-state action disjunct. Zero keeps every disjunct a flat conjunction.
max_action_depth = 3
# Transitions explored from an initial state of a generated module.
# Every next-state disjunct is guarded by the step counter staying below it.
max_steps = 5
# Maximum weak and strong fairness conditions in a generated specification.
# Fairness is generated only with the "temporal" category enabled.
max_fairness = 2
ignore = ["unbound", "exotic"]
# Selection slots per expression form, for the forms that are not weighted one.
# A form with weight N is N times as likely as an unweighted form applicable to the same request.
weights = { name = 8, enum_set = 16 }
# Ordered TLA+ source directories or JARs, relative to this config file.
classpath = []
# Additional operator kinds: { module = "MyModule", operators = ["MyOp"] }.
custom_operators = []

[workflow]
# Maximum number of unique entries across every workflow directory.
# A stage table that omits max_entries inherits this value.
max_entries = 1000

[workflow.inputs]
# Maximum current occupancy of 00-inputs.
# Defaults to workflow.max_entries.
# max_entries = 1000
# Known-defect signature databases, relative to this config file.
# A candidate that matches a signature goes to 00-known-defects; [] admits every candidate.
known_defects = []
# Quarantined entries kept per signature in 00-known-defects; further matches are only counted.
known_defect_samples = 100

[workflow.parser]
# Maximum combined occupancy of the parser result directories.
# Defaults to workflow.max_entries.
# max_entries = 1000
# Wall-clock limit for parsing one generated specification.
timeout_sec = 30

[workflow.tlc]
# Maximum combined occupancy of the TLC result directories.
# Defaults to workflow.max_entries.
# max_entries = 1000
# Wall-clock limit for checking one generated specification.
timeout_sec = 30
# Maximum heap allocated to each isolated TLC JVM.
max_heap_mb = 512
# Number of TLC model-checking workers in each isolated JVM.
workers = 1

[workflow.apalache]
# Maximum combined occupancy of the Apalache result directories.
# Defaults to workflow.max_entries.
# max_entries = 1000
# Wall-clock limit for checking one generated specification.
timeout_sec = 30
# Maximum heap allocated to each persistent Apalache worker JVM.
max_heap_mb = 1024
# Number of concurrent FuzzTLA Apalache workers.
# Initialized to half the available processors, rounded down (at least one).
workers = ${APALACHE_WORKERS}

[pbt]
# Inclusive upper bound on a randomly generated input's length.
max_input_bytes = 10240
# Number of uniformly selected collection-richness cohorts.
richness_cohorts = 10
# Weight multiplier for each level of collection nesting.
richness_nesting_base = 2.0
# Growth factor for successive cohort admission thresholds.
richness_threshold_base = 1.5

[mutator]
# Entries each generation admits before the quality gate selects from it.
generation_size = 1000
# Upper bound on the share of a generation's agreeing entries the gate keeps in 04quality-pass.
select_fraction = 0.05
# Share of a generation mutated from 04quality-pass; the rest is generated by PBT.
feedback_ratio = 0.5
# Cap on the edits stacked on one mutant.
max_edits = 1
# Relative weight of each mutation operator; an omitted operator has weight 0.
weights = { random_byte = 8, bitflip = 8, parity_flip = 8, copy = 4, duplicate = 1, insert = 1, erase = 1, splice = 1 }
# Exploration patterns of ADR 0008 that exclude an entry from 04quality-pass.
shallow_patterns = ["vacuous_pass", "initial_state_violation", "early_failure", "no_discovering_action", "counter_only_progress"]
# Entries of 04quality-pass per behaviour cell of ADR 0013; 0 removes the bound.
cell_capacity = 4
# Also keep an entry that adds an operator-edge coverage feature (ADR 0013).
coverage = true
